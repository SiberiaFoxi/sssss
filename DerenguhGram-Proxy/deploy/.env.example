# Copy to .env and edit. The server reads these from the process environment.
SERVER_PORT=3183
SERVER_IP=0.0.0.0
DERENGUH_PUBLIC_HOST=your.server.host
# 32-char hex (16 bytes). Generate: python3 -c "from derenguh_proxy import generate_secret; print(generate_secret().hex())"
DERENGUH_SECRET=
DERENGUH_SNI=music.yandex.ru
DERENGUH_ALLOWED_SNI=music.yandex.ru,vk.com,rutube.ru,yandex.ru,dzen.ru,vkvideo.ru
DERENGUH_CODEC=zlib
DERENGUH_MAX_CONN=64
DERENGUH_MASK=true
DERENGUH_MASK_HOST=music.yandex.ru
DERENGUH_MASK_PORT=443
DERENGUH_MASK_USE_SNI=true
DERENGUH_PREFER_IPV6=false
DERENGUH_IGNORE_TIME_SKEW=false
DERENGUH_IDLE_TIMEOUT=300
DERENGUH_LOG_LEVEL=info
